
# Default: automatically detect text files and normalize to LF
* text=auto

# Shell scripts: always LF, including Windows working copies
*.sh text eol=lf

# Windows batch files: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Visual Studio project and solution files
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Binary files: never perform line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.pdf binary
*.dll binary
*.so binary
*.a binary
*.lib binary
